# =============================================================================
# Social Studio X — Environment Configuration
# Copy this file to `.env.local` and fill in your values.
#   cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Google Gemini (REQUIRED)
# Core backend for text, image, image-edit, voice, and video generation.
# Get an API key from Google AI Studio: https://aistudio.google.com/
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Legacy fallback key name (used only if GEMINI_API_KEY is not set).
# API_KEY=your_legacy_key_here

# -----------------------------------------------------------------------------
# Vercel AI Gateway (OPTIONAL)
# Enables curated third-party text / image / voice / video models via the AI
# SDK. When set, the Model Management view (/models) lets you pick per-modality
# gateway defaults and live-test any model. Gemini stays the default backend.
#   https://vercel.com/docs/ai-gateway
# -----------------------------------------------------------------------------
AI_GATEWAY_API_KEY=your_gateway_api_key_here
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai

# -----------------------------------------------------------------------------
# Cloudinary (OPTIONAL but recommended for the Blog Studio)
# Generated blog section images are uploaded here and embedded in posts as
# hosted URLs — raw base64/data URLs are NEVER stored in post markdown. Without
# these credentials the "Upload Image to Blog" action cannot run.
#
# To use a different image-hosting provider instead, change the upload
# implementation in services/server/cloudinaryService.ts (and the /api/image/upload
# route) to point at that provider. Without a hosted image upload path, generated
# blog images cannot be attached before publishing.
#
# Get credentials from the Cloudinary Console: https://cloudinary.com/console
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
